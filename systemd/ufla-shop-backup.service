[Unit]
Description=Backup do banco loja (pg_dump com rotacao de 7)
After=postgresql.service

[Service]
Type=oneshot
User=ufla-shop
Group=ufla-shop
EnvironmentFile=/etc/ufla-shop.env
ExecStart=/opt/ufla-shop/scripts/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ufla-shop
